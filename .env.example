# Model (the swap point) -- must support tool/function calling
MODEL_BASE_URL=https://api.your-provider.com/v1
MODEL_API_KEY=your-free-key
MODEL_NAME=some-strong-tool-calling-model

# --- Ollama Cloud (recommended free option) ---
# Runs on Ollama's infra (fast, seconds not minutes), free "Low Usage" tier,
# confirmed tool-calling support, zero local compute -- while still going
# through Ollama's local endpoint below. Run `ollama signin` once first.
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_API_KEY=ollama
# MODEL_NAME=gpt-oss:20b-cloud
# NOTE: not every *:cloud model is free, and names rot fast. VERIFY, never
# assume from the name:   python check_model.py <name>   (a real tool call)
#                         python check_model.py --list   (what this endpoint has)
#
# Probed on Ollama Cloud. Each PASS is a SEPARATE free quota bucket, so when one
# is rate limited you switch to the next and keep working:
#   gpt-oss:120b-cloud  PASS  3.9s
#   gemma4:cloud        PASS  4.6s   (also a vision model -- can be the critic too)
#   gpt-oss:20b-cloud   PASS  4.7s
#   gemma4:31b-cloud    PASS  6.8s
# Probed and NOT usable, so don't retry them from memory:
#   glm-5.2:cloud                                    403, needs a subscription
#   qwen3-coder:480b-cloud, deepseek-v3.1:671b-cloud, kimi-k2:1t-cloud,
#   glm-4.6:cloud, minimax-m2:cloud, deepseek-v3.2:cloud       all RETIRED

# --- Fully local (offline, but slow without a GPU) ---
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_API_KEY=ollama
# MODEL_NAME=qwen2.5-coder:7b

# --- VISION CRITIC (optional, but the biggest quality lever) ---
# A SECOND model, used only to look at screenshots of each finished section and
# report what is visibly broken. Deliberately separate from the generator: the
# generator needs reliable tool calling and runs ~50 times per design, while the
# critic needs eyes and runs a handful of times. One model rarely does both well.
#
# Cost is small precisely because it runs so rarely -- a hosted vision model is
# usually the right choice here even when the generator is free and local.
# Leave blank to disable screenshot critique entirely (geometry checks still run).
#
# Anthropic:
# CRITIC_BASE_URL=https://api.anthropic.com/v1
# CRITIC_API_KEY=sk-ant-...
# CRITIC_MODEL_NAME=claude-sonnet-4-5
#
# OpenAI:
# CRITIC_BASE_URL=https://api.openai.com/v1
# CRITIC_API_KEY=sk-...
# CRITIC_MODEL_NAME=gpt-4o
#
# OpenRouter (many vision models behind one key):
# CRITIC_BASE_URL=https://openrouter.ai/api/v1
# CRITIC_API_KEY=sk-or-...
# CRITIC_MODEL_NAME=qwen/qwen-2.5-vl-72b-instruct
#
# Ollama (free; `ollama pull <a vision model>` first, then use that exact name):
# CRITIC_BASE_URL=http://localhost:11434/v1
# CRITIC_API_KEY=ollama
# CRITIC_MODEL_NAME=<the name you pulled>
#
# Do NOT copy a model name out of this file and trust it -- hosted names rot.
# Probing this endpoint returned 410 "qwen3-vl:235b was retired" and 410
# "gemma3:27b was retired" for two models that were current when this project
# was written. Pick from ollama.com/library (vision), pull it, then ALWAYS
# confirm with:  python check_critic.py
#
# Field order matters: BASE_URL is a URL, API_KEY is a credential,
# MODEL_NAME is the model. A model name in the key field fails as a 401/403.
CRITIC_BASE_URL=
CRITIC_API_KEY=
CRITIC_MODEL_NAME=

# --- READING ATTACHMENTS (optional) ---
# The model that looks at a screenshot you attach and writes down what it sees,
# so the agent can rebuild it. Any multimodal model works; verify it the same
# way, with `python check_critic.py`.
#
# You usually do NOT need to set these. Attachments fall through
# VISION_* -> CRITIC_* -> the main model, so configuring the vision critic above
# already unlocks screenshot input, and the dashboard has a "Vision model" field
# that sets VISION_MODEL_NAME alone (borrowing the endpoint and key from above).
# Set these only to read attachments with a DIFFERENT model than you critique
# with -- e.g. a stronger, pricier one, since it runs once per attachment
# rather than once per section.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL_NAME=

# Bridge
# Use "localhost", not "127.0.0.1" -- Figma's plugin manifest validator
# rejects raw IP literals in networkAccess.allowedDomains.
BRIDGE_HOST=localhost
BRIDGE_PORT=9223

# Loop limits (guardrails against runaway runs)
MAX_RETRIES=3
MAX_STEPS=40
